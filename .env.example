# --- Django core ---
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Neon) ---
# Use the DIRECT (unpooled) connection string, not the pooled one — psycopg3
# server-side prepared statements are incompatible with PgBouncer transaction
# pooling. Neon dashboard -> Connection Details -> uncheck "Pooled connection".
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/ascend?sslmode=require

# --- Timezone ---
TIME_ZONE=Asia/Kolkata

# --- Auth ---
# Machine token for /api/ingest/*, /api/today/, /api/email-queue/.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=change-me-to-a-long-random-token
# Username of the Django superuser that ingested/machine-written rows are
# attributed to. Defaults to the first superuser found if unset.
INGEST_OWNER_USERNAME=

# --- Render-specific (set automatically on Render, harmless elsewhere) ---
RENDER_EXTERNAL_HOSTNAME=

# --- Superuser bootstrap (Render only — leave unset for local dev, where
# you'll just run `python manage.py createsuperuser` yourself) ---
# Render's free plan has no Shell/SSH/Jobs access, so `manage.py
# createsuperuser` can't be run interactively there. render.yaml's build
# command instead runs `manage.py bootstrap_superuser`, which reads these
# three and creates exactly one superuser, then no-ops on every later
# deploy. Set them in the Render dashboard's Environment tab, not here —
# this file is committed, real secrets never belong in it.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Notion "Daily Board" sync (docs/NOTION_SYNC.md) ---
# Optional — leave both unset and the app runs completely normally;
# POST /api/sync/notion/ just returns a clean 503 until these are set.
# NOTION_TOKEN: internal-integration secret from notion.so/my-integrations.
# Remember to share the Daily Board page with that integration — an
# unshared page 404s from Notion's own API regardless of a valid token.
NOTION_TOKEN=
# Defaults to the Daily Board's id in code — only set this if syncing a
# different Notion database.
NOTION_DAILY_BOARD_DB_ID=94fb5ba274ab499b8ae23e652774be2a
